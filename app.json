{
  "expo": {
    "scheme": "lardermind",
    "name": "LarderMind",
    "slug": "PantryApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F0E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lardermind.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F0E8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lardermind.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "react-native-iap",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "cf38de84-b63d-4d79-99fa-2dc29373f4d0"
      }
    },
    "owner": "bertjiayu"
  }
}
